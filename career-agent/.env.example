# Export these on the LOCAL machine only. Never commit values.
OPENAI_API_KEY=
LLM_MODEL=
# Required before any live LLM call: daily limit in GBP, and token prices (or a per-call reserve when unknown).
LLM_BUDGET_GBP_DAILY=
LLM_BUDGET_GBP_TOTAL=
LLM_PRICE_GBP_PER_MTOK_INPUT=
LLM_PRICE_GBP_PER_MTOK_OUTPUT=
LLM_UNKNOWN_PRICE_RESERVE_GBP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_TO=
# At least 24 random characters; the dashboard asks for it.
CAREER_AGENT_TOKEN=
CAREER_AGENT_PORT=8765
# true only with standing authorisation; without it you press submit, so the browser must be visible.
CAREER_HEADLESS=false
# Optional: an existing, tested Chromium.
CAREER_BROWSER_EXECUTABLE=
