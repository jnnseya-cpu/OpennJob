# Export these variables on the LOCAL server, never the hosted trial.
OPENAI_API_KEY=
LLM_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_TO=
CAREER_AGENT_TOKEN=
# Leave false: --submit needs a visible browser because you click submit yourself. true is for dry runs only.
CAREER_HEADLESS=false
# Optional existing compatible Chromium path if the standard browser download is unavailable.
CAREER_BROWSER_EXECUTABLE=
