{
  "id": "local-fixture",
  "note": "LOCAL TEST ONLY. Tests replace {BASE} with the address of the fixture server.",
  "exact_url": "{BASE}/application.html",
  "reviewed": true,
  "route_tested": true,
  "jd_selector": "#jd",
  "form_selector": "#apply",
  "fields": [
    {
      "selector": "#name",
      "key": "name"
    },
    {
      "selector": "#email",
      "key": "email"
    },
    {
      "selector": "#rtw",
      "key": "right_to_work",
      "type": "select",
      "source": "work_rights",
      "value_map": {
        "true": "Yes",
        "false": "No"
      }
    },
    {
      "selector": "#declare",
      "key": "accuracy_declaration",
      "type": "checkbox",
      "declaration": true
    }
  ],
  "uploads": [
    {
      "selector": "#cv",
      "document": "cv"
    }
  ],
  "submit_selector": "#send",
  "receipt_selector": "#receipt",
  "receipt_pattern": "FIXTURE-001",
  "blocking_selectors": [
    "iframe[src*=\"recaptcha\"]",
    "iframe[src*=\"hcaptcha\"]"
  ]
}
