# OpennJob on one machine: the web app (static files) and the API behind one HTTPS origin.
# Caddy obtains and renews the TLS certificate for {$DOMAIN} automatically (Let's Encrypt).
# The browser calls the API at https://{$DOMAIN}/api/..., so no CORS is needed.
{
	email {$ACME_EMAIL}
	servers {
		# Behind another web server on this machine (deploy/docker-compose.behind-proxy.yml), keep the
		# client address it passes on. A client on the internet never comes from a private range.
		trusted_proxies static private_ranges
	}
}

# The domain (Caddy gets the certificate), or ":8080" when another web server in front does HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Next.js inlines its bootstrap scripts, hence 'unsafe-inline' for scripts; everything else is same-origin only.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle_path /api/* {
		# A name only OpennJob's API answers to: on a shared server the web container also joins another
		# network, where a container of another app may be called "api".
		reverse_proxy opennjob-api:8080
	}

	handle {
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Pages, the config and theme.js: always ask the server first, so a new version shows at the
		# next open (the hashed files above never change, so they may be kept for a year).
		@pages not path /_next/static/*
		header @pages Cache-Control "no-cache"
		root * /srv
		try_files {path} {path}/index.html /404.html
		file_server
	}
}
