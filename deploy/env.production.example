# Copy to .env.production on the server (never commit it) and fill every value.
# Generate secrets on the server:
#   openssl rand -base64 48            -> OPENNJOB_JWT_SECRET
#   openssl rand -base64 32            -> OPENNJOB_DATA_KEY   (keep a copy offline: losing it loses every CV)
#   openssl rand -base64 24            -> POSTGRES_PASSWORD
DOMAIN=opennjob.com
ACME_EMAIL=support@opennjob.com
POSTGRES_PASSWORD=REPLACE_ME
OPENNJOB_JWT_SECRET=REPLACE_ME
OPENNJOB_DATA_KEY=REPLACE_ME
# Private pilot: the invited address(es), comma separated.
OPENNJOB_REGISTRATION_ALLOWLIST=pilot.applicant@example.org
# E-mail: a mailbox over SMTP (recommended for the pilot; set it with `bash deploy/set-smtp.sh`,
# which asks for the password without showing it), or Resend. Neither set: e-mail is recorded, never sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
OPENNJOB_EMAIL_FROM="OpennJob <support@opennjob.com>"
OPENNJOB_BRAND_FOOTER="OpennJob · support@opennjob.com"
# Optional: an LLM for statements and feedback (otherwise the no-AI drafter is used).
ANTHROPIC_API_KEY=
OPENNJOB_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher is more careful and costs more tokens.
OPENNJOB_LLM_EFFORT=medium
# Job sources: none has had its terms checked (docs/sources.md). Set with: bash deploy/set-keys.sh
OPENNJOB_GREENHOUSE_BOARDS=
OPENNJOB_LEVER_COMPANIES=
OPENNJOB_ASHBY_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
# Searches come from each person's CV (job titles) and places on Profile; these only cap how many.
OPENNJOB_SEARCH_MAX_QUERIES_PER_USER=40
OPENNJOB_SEARCH_MAX_QUERIES_PER_REFRESH=60
# Daily jobs (discovery 06:00, report 09:00, retention 03:00, London time). true by default.
OPENNJOB_SCHEDULER=true
# Where failure alerts go (needs RESEND_API_KEY to actually send).
OPENNJOB_OPERATOR_EMAIL=support@opennjob.com
# Delete records older than this many days (30 or more). Empty = keep everything.
OPENNJOB_RETENTION_DAYS=
