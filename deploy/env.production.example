# Copy to .env.production on the server (never commit it) and fill every value.
# Generate secrets on the server:
#   openssl rand -base64 48            -> OPENNJOB_JWT_SECRET
#   openssl rand -base64 32            -> OPENNJOB_DATA_KEY   (keep a copy offline: losing it loses every CV)
#   openssl rand -base64 24            -> POSTGRES_PASSWORD
DOMAIN=app.example.org
ACME_EMAIL=ops@example.org
POSTGRES_PASSWORD=REPLACE_ME
OPENNJOB_JWT_SECRET=REPLACE_ME
OPENNJOB_DATA_KEY=REPLACE_ME
# Private pilot: the invited address(es), comma separated.
OPENNJOB_REGISTRATION_ALLOWLIST=pilot.applicant@example.org
# Optional: real e-mail (otherwise e-mail is recorded in sandbox mode, never sent).
RESEND_API_KEY=
OPENNJOB_EMAIL_FROM=
# Optional: an LLM for statements and feedback (otherwise the no-AI drafter is used).
ANTHROPIC_API_KEY=
OPENNJOB_MODEL=
