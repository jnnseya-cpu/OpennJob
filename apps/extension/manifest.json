{
  "manifest_version": 3,
  "name": "OpennJob (development build)",
  "version": "0.1.0",
  "description": "Fills job application forms from your OpennJob profile, in your own browser. Sensitive fields wait for your confirmation.",
  "key": "",
  "action": {
    "default_title": "OpennJob",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"]
}
