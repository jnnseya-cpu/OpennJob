# OpennJob - copy this file to .env and fill in what you need.
# Never commit .env. Nothing in this file is a real secret.

# ---- Secrets -----------------------------------------------------------------------
# REQUIRED when NODE_ENV=production: the API refuses to start without both.
#
# Signs the access tokens users get when they sign in. At least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Outside production, leaving it empty makes the API invent one for each run (everyone is
# signed out on restart). Changing it signs everyone out.
OPENNJOB_JWT_SECRET=

# Encrypts CV text, credential passports and supporting statements at rest (AES-256-GCM).
# Exactly 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEPING, BACKING UP AND ROTATING THIS KEY IS YOUR JOB. If it is lost, the encrypted data
# cannot be read by anyone. The code has no rotation: see README, "Encryption at rest".
OPENNJOB_DATA_KEY=

# ---- Runtime -----------------------------------------------------------------------
# "production" switches on the start-up checks above and stops any chrome-extension://
# origin being accepted by default (see CORS below).
NODE_ENV=development

# Where the API listens. It binds to localhost only unless you change HOST.
# In a container use HOST=0.0.0.0 (the Dockerfile sets it, with PORT=8080).
PORT=3000
HOST=127.0.0.1

# ---- Database ----------------------------------------------------------------------
# PostgreSQL 16 connection string. EMPTY = in-memory store: everything is lost when the
# API stops. With it set, run `npm run migrate` before starting the API; the API refuses
# to start on a database that is missing migrations.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
#   Cloud SQL socket: postgres://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Only for docker-compose.yml: the password of its own postgres container.
POSTGRES_PASSWORD=

# ---- Accounts ----------------------------------------------------------------------
# How long an access token lasts, in seconds (60 to 86400). There are no refresh tokens:
# when it runs out the user signs in again.
OPENNJOB_JWT_TTL_SECONDS=3600
# bcrypt cost for password hashes (4 to 15). 12 is the default; lower only in tests.
OPENNJOB_BCRYPT_ROUNDS=12
# The versions of the terms and of the privacy notice that POST /auth/register must be
# given in acceptedTermsVersion / acceptedPrivacyVersion. Change them when the documents
# change. "draft-1" means the real documents do not exist yet (see GO-LIVE.md).
OPENNJOB_TERMS_VERSION=draft-1
OPENNJOB_PRIVACY_VERSION=draft-1
# Rate limit on /auth/*: attempts allowed per client address, and per email address, in
# one window. Counted in the memory of each API process.
OPENNJOB_AUTH_RATE_LIMIT_MAX=10
OPENNJOB_AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# ---- HTTP --------------------------------------------------------------------------
# Browser origins allowed to call the API, comma separated: the extension by its id, and the
# candidate web app's origin (http://127.0.0.1:3001 for `npm run dev -w @opennjob/web`):
#   OPENNJOB_CORS_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop,https://app.example.org
OPENNJOB_CORS_ORIGINS=
# true = accept ANY chrome-extension:// origin. Default: true outside production, false
# in production. Leave it false in production and list your extension's id above.
OPENNJOB_CORS_ALLOW_ANY_EXTENSION=
# Largest request body, e.g. 256kb. The largest CV the API accepts fits in the default.
OPENNJOB_BODY_LIMIT=256kb
# Behind a load balancer or Cloud Run, set this so the rate limit sees the caller's
# address and not the proxy's (Express "trust proxy": a hop count such as 1, or true).
# Leave empty when the API is reached directly: otherwise the address can be forged.
OPENNJOB_TRUST_PROXY=

# ---- The 80% rule -----------------------------------------------------------------
# POST /agent/run prepares an application draft for every in-scope, eligible job scoring at
# or above this (a whole number from 0 to 100). Anything else leaves the default of 80.
OPENNJOB_APPLY_THRESHOLD=80

# ---- Employer posting (optional) --------------------------------------------------
# Jobs are discovered by the system from its sources. Employers posting jobs is an optional
# extra and nothing depends on it. Leave this empty to keep POST /employer/jobs closed.
# When set, it is a SEPARATE bearer key for that one route; it is not a user's access token and
# opens nothing else. Use a long random value.
OPENNJOB_EMPLOYER_KEY=

# ---- LLM (optional) ---------------------------------------------------------------
# Without a key, OpennJob uses its deterministic fallbacks (no AI drafting or AI scoring).
ANTHROPIC_API_KEY=
# REQUIRED when ANTHROPIC_API_KEY is set. Confirm the name against Anthropic's current
# model list. If left empty the code falls back to a placeholder constant and warns.
OPENNJOB_MODEL=
# true = also use the LLM to extract criteria from each job advert on POST /jobs/refresh.
# This costs one LLM call per new job, capped by OPENNJOB_LLM_CRITERIA_MAX_JOBS per refresh.
OPENNJOB_LLM_CRITERIA=false
OPENNJOB_LLM_CRITERIA_MAX_JOBS=25

# ---- Job sources (all optional) ---------------------------------------------------
# true = load built-in FICTIONAL sample jobs (a few per industry pack, across several
# countries) so you can try the product with no keys.
OPENNJOB_DEMO_JOBS=true

# Comma-separated boards, each "token" or "token:Employer Name".
OPENNJOB_GREENHOUSE_BOARDS=
OPENNJOB_LEVER_COMPANIES=
OPENNJOB_ASHBY_BOARDS=

# Adzuna (needs both) and Reed API credentials.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated two-letter Adzuna country codes, one search per country (default gb).
# The country is a path segment of Adzuna's URL, e.g. gb, us, fr, de, za. Which codes Adzuna
# supports is from memory and NOT verified: check Adzuna's documentation before relying on it.
ADZUNA_COUNTRIES=gb
REED_API_KEY=

# Search terms used for Adzuna and Reed.
OPENNJOB_SEARCH_KEYWORDS=nurse
OPENNJOB_SEARCH_LOCATION=

# Optional: where the migration files are, if not db/migrations next to the code.
# OPENNJOB_MIGRATIONS_DIR=

# ---- Tests only -------------------------------------------------------------------
# The PostgreSQL-backed tests run only when DATABASE_URL is set in the shell that runs
# `npm test`. `npm run test:pg` starts a throwaway PostgreSQL and sets it for you.
# Playwright looks for Chromium in PLAYWRIGHT_BROWSERS_PATH (set in your shell, not here).
# To force a specific Chromium binary for the end-to-end tests, export this in your shell:
# OPENNJOB_CHROMIUM_PATH=/path/to/chrome
