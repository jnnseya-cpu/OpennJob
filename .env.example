# OpennJob - copy this file to .env and fill in what you need.
# Never commit .env. Nothing in this file is a real secret.

# ---- API (required) ---------------------------------------------------------------
# Single shared bearer token for the one development user. PLACEHOLDER for real auth.
# Use a long random value, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENNJOB_API_TOKEN=

# Where the API listens. It binds to localhost only unless you change HOST.
PORT=3000
HOST=127.0.0.1

# Extra browser origins allowed to call the API (comma separated). chrome-extension://
# origins are always allowed. Leave empty unless you build a web front end.
OPENNJOB_CORS_ORIGINS=

# ---- The 80% rule -----------------------------------------------------------------
# POST /agent/run prepares an application draft for every in-scope, eligible job scoring at
# or above this (a whole number from 0 to 100). Anything else leaves the default of 80.
OPENNJOB_APPLY_THRESHOLD=80

# ---- Employer posting (optional) --------------------------------------------------
# Jobs are discovered by the system from its sources. Employers posting jobs is an optional
# extra and nothing depends on it. Leave this empty to keep POST /employer/jobs closed.
# When set, it is a SEPARATE bearer key for that one route; it is not the user's token and
# opens nothing else. Use a long random value.
OPENNJOB_EMPLOYER_KEY=

# ---- LLM (optional) ---------------------------------------------------------------
# Without a key, OpennJob uses its deterministic fallbacks (no AI drafting or AI scoring).
ANTHROPIC_API_KEY=
# REQUIRED when ANTHROPIC_API_KEY is set. Confirm the name against Anthropic's current
# model list. If left empty the code falls back to a placeholder constant and warns.
OPENNJOB_MODEL=
# true = also use the LLM to extract criteria from each job advert on POST /jobs/refresh.
# This costs one LLM call per new job, capped by OPENNJOB_LLM_CRITERIA_MAX_JOBS per refresh.
OPENNJOB_LLM_CRITERIA=false
OPENNJOB_LLM_CRITERIA_MAX_JOBS=25

# ---- Job sources (all optional) ---------------------------------------------------
# true = load built-in FICTIONAL sample jobs (a few per industry pack, across several
# countries) so you can try the product with no keys.
OPENNJOB_DEMO_JOBS=true

# Comma-separated boards, each "token" or "token:Employer Name".
OPENNJOB_GREENHOUSE_BOARDS=
OPENNJOB_LEVER_COMPANIES=
OPENNJOB_ASHBY_BOARDS=

# Adzuna (needs both) and Reed API credentials.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated two-letter Adzuna country codes, one search per country (default gb).
# The country is a path segment of Adzuna's URL, e.g. gb, us, fr, de, za. Which codes Adzuna
# supports is from memory and NOT verified: check Adzuna's documentation before relying on it.
ADZUNA_COUNTRIES=gb
REED_API_KEY=

# Search terms used for Adzuna and Reed.
OPENNJOB_SEARCH_KEYWORDS=nurse
OPENNJOB_SEARCH_LOCATION=

# ---- Tests only -------------------------------------------------------------------
# Playwright looks for Chromium in PLAYWRIGHT_BROWSERS_PATH (set in your shell, not here).
# To force a specific Chromium binary for the end-to-end tests, export this in your shell:
# OPENNJOB_CHROMIUM_PATH=/path/to/chrome
